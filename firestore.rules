rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Device tokens are private and only managed by authenticated callables.
    match /mobilePushDevices/{deviceId} {
      allow read, write: if false;
    }

    // Scheduled/event delivery receipts are server-only deduplication records.
    match /mobilePushDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    // Kullanıcı profil ve ayarları — sadece kendi belgesi.
    // isPro ve abonelik/kullanım alanları istisna: ödeme durumunu ve
    // ücretsiz-plan sayacını belirledikleri için kullanıcı kendi kendine
    // yazamaz — sadece güvenilir bir sunucu (Admin SDK, Firestore
    // rule'larını atlar) tarafından değiştirilebilir.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny([
                      'isPro', 'subscriptionReferenceCode', 'subscriptionStatus',
                      'subscriptionProvider', 'subscriptionProductId',
                      'storeOriginalTransactionId',
                      'proSince', 'lastPaymentAt', 'currentPeriodEnd',
                      'plansUsedThisMonth', 'plansMonthWindowStart'
                    ]);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'isPro', 'subscriptionReferenceCode', 'subscriptionStatus',
                      'subscriptionProvider', 'subscriptionProductId',
                      'storeOriginalTransactionId',
                      'proSince', 'lastPaymentAt', 'currentPeriodEnd',
                      'plansUsedThisMonth', 'plansMonthWindowStart',
                      'profilePublic', 'plansPublic', 'followPublic',
                      'locationEnabled', 'locationHistory', 'analyticsEnabled'
                    ]);
      allow delete: if false;

      // Özel seyahat planları — web ve mobil aynı kullanıcı koleksiyonunu
      // paylaşır. Yolun uid parçası sayesinde kullanıcı yalnızca kendi
      // planlarını okuyabilir ve değiştirebilir.
      match /plans/{planId} {
        allow read, create, update, delete: if request.auth != null
                                            && request.auth.uid == uid;

        // One shared checklist state per plan. Both web and mobile use this
        // document, while server timestamps resolve cross-device ordering.
        match /checklist/{checklistId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && checklistId == 'state';
          allow create, update: if request.auth != null
                                && request.auth.uid == uid
                                && checklistId == 'state'
                                && request.resource.data.keys().hasOnly([
                                  'schemaVersion', 'checkedIds', 'updatedAt'
                                ])
                                && request.resource.data.schemaVersion == 1
                                && request.resource.data.checkedIds is list
                                && request.resource.data.checkedIds.size() <= 50
                                && request.resource.data.checkedIds.hasOnly([
                                  'passport', 'visa', 'ticket', 'hotel',
                                  'insurance', 'emergency', 'cash', 'card',
                                  'backup', 'medicine', 'firstaid', 'sunscreen',
                                  'vaccine', 'charger', 'powerbank', 'simcard',
                                  'offline', 'transport', 'clothes', 'shoes',
                                  'lock', 'copies', 'notify'
                                ])
                                && request.resource.data.updatedAt is timestamp;
          allow delete: if false;
        }
      }

      // Private cross-device wallet. Deletes erase personal fields and retain
      // a tombstone so an old browser cannot re-import deleted local records.
      match /wallet/{entryId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.schemaVersion == 1
          && request.resource.data.updatedAt is number
          && ((request.resource.data.deleted == true
            && request.resource.data.keys().hasOnly(['deleted', 'updatedAt', 'schemaVersion']))
          || (request.resource.data.deleted == false
            && request.resource.data.keys().hasOnly(['planId', 'category', 'title', 'reference', 'date', 'note', 'url', 'details', 'createdAt', 'updatedAt', 'schemaVersion', 'deleted'])
            && request.resource.data.planId is string && request.resource.data.planId.size() <= 100
            && request.resource.data.category in ['flight', 'stay', 'ticket', 'insurance', 'document', 'other']
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
            && request.resource.data.reference is string && request.resource.data.reference.size() <= 80
            && request.resource.data.date is string && request.resource.data.date.size() <= 40
            && request.resource.data.note is string && request.resource.data.note.size() <= 500
            && request.resource.data.url is string && request.resource.data.url.size() <= 2048
            && request.resource.data.details is map && request.resource.data.details.size() <= 8
            && request.resource.data.createdAt is number));
        allow delete: if false;
      }
    }

    // Hata raporları — istek-sıklığı sınırı gerektiği için artık sadece
    // submitBugReport Cloud Function'ı (Admin SDK) yazabilir.
    match /bug_reports/{reportId} {
      allow create: if false;
      allow read: if false; // sadece admin okur
    }

    // Herkese açık planlar — yeni paylaşım (create) istek-sıklığı sınırı
    // gerektiği için artık sadece sharePublicPlan Cloud Function'ı yazabilir.
    match /publicPlans/{planId} {
      // Tekil bağlantılar linke özel planları açabilir; koleksiyon sorguları
      // yalnızca feedVisible=true belgeleri (ve sahibinin kendi sorgusunu) görür.
      allow get: if true;
      allow list: if resource.data.feedVisible == true
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow delete: if false;
      // İçerik, kimlik ve puan değişiklikleri yalnızca doğrulayan Cloud
      // Functions tarafından yapılır (Admin SDK kuralları atlar).
      allow update: if false;
    }

    // Puan işlemleri Cloud Function üzerinden yapılır. Kullanıcı arayüzü yalnızca
    // oturum sahibinin kendi puan belgesini doğrudan okuyabilir.
    match /planRatings/{ratingId} {
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Takip sistemi — sadece kendi verisine erişim. Takip ETME (create) istek-
    // sıklığı sınırı gerektiği için artık sadece followUserAction Cloud
    // Function'ı yazabilir. Takipten çıkma (delete) düşük risk, client'ta kaldı.
    match /userFollows/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // E-posta doğrulama kodları — sadece Cloud Functions (Admin SDK) erişir,
    // istemci tarafından doğrudan okunamaz/yazılamaz.
    match /emailVerificationCodes/{uid} {
      allow read, write: if false;
    }

    // Rate-limit sayaçları — sadece Cloud Functions (Admin SDK) erişir.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // İletişim formu cooldown'ları — sadece Cloud Functions (Admin SDK) erişir.
    match /contactCooldowns/{docId} {
      allow read, write: if false;
    }

    // iyzico abonelik ödemeleri — token→uid ve referans kodu→uid eşlemeleri,
    // kuyruklanmış webhook olayları: hepsi sadece Cloud Functions (Admin SDK)
    // yazar/okur, client'a hiç açılmaz.
    match /subscriptionCheckouts/{token} {
      allow read, write: if false;
    }
    match /subscriptionsByRef/{refCode} {
      allow read, write: if false;
    }
    match /pendingWebhookEvents/{refCode} {
      allow read, write: if false;
    }
    // Future Google Play / App Store receipts and server notifications remain
    // server-only. A mobile client can never grant itself Pro access.
    match /mobileStoreTransactions/{transactionId} {
      allow read, write: if false;
    }
    match /mobileStoreNotifications/{notificationId} {
      allow read, write: if false;
    }

    // Ödeme kayıtları — sadece Cloud Functions yazar (activateSubscription).
    // Kullanıcı SADECE kendi ödemelerini okuyabilir (Fatura Geçmişi ekranı).
    match /payments/{orderReferenceCode} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }
  }
}
