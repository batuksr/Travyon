rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profil ve ayarları — sadece kendi belgesi
    match /users/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Hata raporları — sadece giriş yapmış kullanıcı kendi raporunu yazabilir
    match /bug_reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read: if false; // sadece admin okur
    }

    // Herkese açık planlar
    match /publicPlans/{planId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      // Plan sahibi her şeyi güncelleyebilir/silebilir
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
                      // Plan sahibi her alanı güncelleyebilir
                      resource.data.userId == request.auth.uid
                      ||
                      // Diğer kullanıcılar SADECE puan alanlarını yazabilir
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['avgRating', 'ratingCount'])
                    );
    }

    // Puan işlemleri
    match /planRatings/{ratingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Takip sistemi — sadece kendi verisine erişim
    match /userFollows/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // E-posta doğrulama kodları — sadece Cloud Functions (Admin SDK) erişir,
    // istemci tarafından doğrudan okunamaz/yazılamaz.
    match /emailVerificationCodes/{uid} {
      allow read, write: if false;
    }
  }
}
