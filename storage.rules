rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatar is deliberately shareable with signed-in community members.
    // No wildcard grants this access to private files in the same folder.
    match /users/{userId}/avatar.jpg {
      allow get:   if request.auth != null;
      allow list:  if false;
      allow create, update: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 512 * 1024
                   && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // Existing non-avatar files remain readable by their owner only.
    // No private upload workflow exists yet: deny writes until its validation
    // and non-shareable download mechanism are implemented.
    match /users/{userId}/{allPaths=**} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, write: if false;
    }
  }
}
